# LLM Provider Configuration
# Copy this file to .env and fill in your values
# Supported providers: openai, anthropic, gemini

# ⚠️ WARNING: Default uses a PREVIEW model for testing thoughtSignature feature.
# Preview models may have availability issues or different behavior.
# For production use, consider openai (gpt-4o-mini) or anthropic (claude-sonnet-4-5).
LLM_PROVIDER=gemini
API_KEY=your-api-key-here
# BASE_URL=  # optional: set to a custom endpoint (e.g. vLLM, Azure)
MODEL=gemini-2.5-flash-lite-preview-06-17

# Gemini-specific (Vertex AI - optional, uses ADC if PROJECT is set)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Thinking configuration (Gemini 2.5+)
# 0 = disabled, -1 = dynamic budget, >0 = specific token budget
# STORE_THINKING: when true, thinking blocks are preserved in context for multi-turn reasoning
THINKING_BUDGET=2048
STORE_THINKING=true

# Agent Behaviour
MAX_LOOPS=30
MAX_TOKENS=8000
TOTAL_TIMEOUT=300
TEMPERATURE=0.7

# System Prompt
SYSTEM_PROMPT=You are a helpful assistant. Use tools when needed. Think step by step.
